# Application
NODE_ENV=development
PORT=3000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DATABASE=medtrack

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=medtrack_nosql

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Set to 1 only when you want init-database.sh to skip CSV and MongoDB loading.
SKIP_DATA_LOAD=0
